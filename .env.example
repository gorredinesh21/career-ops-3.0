# career-ops-3.0 — Environment Variables
# Copy to .env and fill in your values:  cp .env.example .env

# ── LLM backend for the LangChain pipeline ────────────────────────────────────
# ollama (local, free, unlimited — default) | gemini (cloud)
LLM_PROVIDER=ollama

# ── Ollama (local) ────────────────────────────────────────────────────────────
# Install: https://ollama.com  then:  ollama pull llama3.1
OLLAMA_HOST=http://localhost:11434
OLLAMA_RATING_MODEL=llama3.1
OLLAMA_RESUME_MODEL=llama3.1

# ── Gemini (cloud fallback — set LLM_PROVIDER=gemini) ─────────────────────────
# Free key: https://aistudio.google.com/apikey  (free tier is ~20 req/day per model)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_RATING_MODEL=gemini-2.5-flash
GEMINI_RESUME_MODEL=gemini-2.5-flash

# Drop jobs whose stated minimum years-of-experience exceeds this.
MAX_MIN_EXPERIENCE=3

# ── Optional ──────────────────────────────────────────────────────────────────
# GITHUB_TOKEN=...   # raises GitHub API rate limit for build-project-catalog.mjs
# HUGGINGFACEHUB_API_TOKEN=...
